{
  "name": "lokasyon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "emulators": "XDG_CONFIG_HOME=\"$PWD/.cache/config\" FIREBASE_EMULATORS_PATH=\"$PWD/.cache/firebase\" firebase emulators:start --project demo-lokasyon --only auth,firestore,storage",
    "test": "vitest run tests/*.test.ts",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=\"$PWD/.cache/playwright\" playwright test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "jspdf": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "vitest": "^3.0.0",
    "firebase-tools": "^14.0.0",
    "@playwright/test": "^1.55.0"
  }
}
