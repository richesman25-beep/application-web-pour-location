# Copy to android/keystore.properties after creating your upload key in Android Studio.
# The actual keystore and passwords must never be committed.
# Use forward slashes even on Windows, e.g. C:/Users/YourName/keys/lokasyon-upload.jks
storeFile=/absolute/path/to/lokasyon-upload.jks
storePassword=YOUR_LOCAL_STORE_PASSWORD
keyAlias=lokasyon-upload
keyPassword=YOUR_LOCAL_KEY_PASSWORD
